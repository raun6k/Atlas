# Copy to .env (gitignored). Never commit filled values.
# Webhook and zrok steps: docs/06-operations/configuration.md
# Live Mode keys (rzp_live_...) must be rejected at process start.

# Atlas Core / Worker
ATLAS_ENVIRONMENT=test
ATLAS_POSTGRES_URL=postgres://atlas:atlas@localhost:5432/atlas?sslmode=disable
ATLAS_PUBLIC_ORIGIN=https://replace-me.share.zrok.io
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_CALLBACK_ORIGIN=https://replace-me.share.zrok.io
RAZORPAY_CAPTURE_MODE=automatic
ATLAS_HOST_PROOF_TTL_SECONDS=60
ATLAS_CHECKOUT_AUTHORITY_TTL_SECONDS=120
ATLAS_PROPOSAL_HOLD_TTL_SECONDS=600
ATLAS_JOB_LEASE_SECONDS=30
ATLAS_OFFER_TTL_SECONDS=90
ATLAS_SUBSTITUTION_DEADLINE_SECONDS=900

# Gateway
ATLAS_CORE_GRPC_ADDR=127.0.0.1:9090
ATLAS_GATEWAY_HTTP_ADDR=127.0.0.1:8080
ATLAS_HOST_BEARER_HASH=
ATLAS_MCP_RATE_LIMIT_PER_MINUTE=60
ATLAS_ADMIN_RATE_LIMIT_PER_MINUTE=120
ATLAS_CORE_HTTP_ADDR=127.0.0.1:9091
ATLAS_HOST_AUDIENCE=atlas.merchant.v1
ATLAS_REQUIRED_MIGRATION=0140_join_payment_extensions.sql
ATLAS_MIGRATIONS_DIR=db/atlas/migrations
ATLAS_FIXTURE_DIR=db/atlas/fixtures/quickmart-v1
ATLAS_HOST_TEST_PUBKEY=
ATLAS_TEST_HOST_BEARER=
ATLAS_TEST_ADMIN_BEARER=
ATLAS_TEST_FIXTURE_BEARER=
ATLAS_EXPORT_DIR=

# Payment runner (no Razorpay secret, no database URL)
ATLAS_RUNNER_ENDPOINT=http://127.0.0.1:8080
ATLAS_RUNNER_EXECUTOR_CREDENTIAL=
ATLAS_RUNNER_BROWSER_TIMEOUT_MS=90000
ATLAS_RUNNER_HTTP_ADDR=127.0.0.1:8091

# AtlasLab
# Host publish for Lab Postgres. In-compose Lab still uses atlaslab-postgres:5432.
# If make up fails with "5433: bind: address already in use", set a free port
# (e.g. 15433) here and in ATLASLAB_POSTGRES_URL.
ATLASLAB_POSTGRES_HOST_PORT=5433
ATLASLAB_POSTGRES_URL=postgres://atlaslab:atlaslab@localhost:5433/atlaslab?sslmode=disable
ATLAS_MCP_URL=http://127.0.0.1:8080/mcp
ATLASLAB_HTTP_ADDR=127.0.0.1:8090
# Same value as ATLASLAB_SERVICE_TOKEN. Lab HTTP requires Authorization: Bearer.
ATLASLAB_MODE=release
ATLASLAB_API_TOKEN=
ATLASLAB_API_READ_TOKEN=
ATLASLAB_API_WRITE_TOKEN=
ATLASLAB_HOST_ID=host_atlaslab_quickmart
ATLASLAB_HOST_KEY_ID=host_atlaslab_test_key
ATLASLAB_HOST_BEARER=
ATLASLAB_HOST_SIGNING_KEY=
ATLASLAB_FIXTURE_CONTROL_CREDENTIAL=
ATLASLAB_FIXTURE_SNAPSHOT_ID=fix_quickmart_v1
ATLASLAB_MOCK_MCP=0
ATLASLAB_MOCK_FIXTURE_RESET=0
OPENROUTER_API_KEY=
ATLASLAB_MAX_TURNS=12
ATLASLAB_MAX_TOOL_CALLS=12
ATLASLAB_MAX_WALL_SECONDS=180
ATLASLAB_MAX_TOKENS=12000
ATLASLAB_MAX_COST_USD=1.00
ATLASLAB_DEFAULT_BUYER_SPEND_MINOR=250000
ATLASLAB_CUSTOM_INPUT_MAX_CHARS=4000
# Explicit operator-assisted provider proof. AtlasLab pauses each commercial
# arm until signed webhook + authenticated provider fetch confirm the order.
ATLASLAB_PROVIDER_ASSISTED_PAYMENTS=0
ATLASLAB_PROVIDER_PAYMENT_WAIT_SECONDS=600
ATLAS_OPERATOR_ASSISTED_PAYMENTS=0

# Frontend
ATLAS_ADMIN_API_URL=http://127.0.0.1:8080
ATLASLAB_API_URL=http://127.0.0.1:8090
ATLAS_ADMIN_SERVICE_TOKEN=
# Same value as ATLASLAB_API_TOKEN. Console sends it as Lab Bearer.
ATLASLAB_SERVICE_TOKEN=
ATLAS_FRONTEND_OPERATOR_SESSION_SECRET=
ATLAS_FRONTEND_SECURE_COOKIES=0
ATLAS_FRONTEND_LOCALE=en-IN
ATLAS_FRONTEND_TIMEZONE=Asia/Kolkata
ATLAS_FRONTEND_HTTP_ADDR=127.0.0.1:3000
ATLAS_MOCK_HTTP_ADDR=127.0.0.1:18080
ATLAS_FRONTEND_ENABLE_MOCKS=0
ATLAS_SEED_OPERATOR_MERCHANT_EMAIL=merchant@quickmart.example
ATLAS_SEED_OPERATOR_EVAL_EMAIL=eval@quickmart.example
ATLAS_SEED_OPERATOR_MERCHANT_PASSWORD=
ATLAS_SEED_OPERATOR_EVAL_PASSWORD=
