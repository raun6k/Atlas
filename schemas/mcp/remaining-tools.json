{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atlas.dev/schemas/mcp/remaining-tools.json",
  "title": "remaining atlas.merchant.v1 tools",
  "tools": {
    "set_intent": ["session_id", "expected_session_context_version", "mission", "planning_budget_minor"],
    "search_catalog": ["session_id", "query"],
    "get_product": ["session_id", "product_id"],
    "get_cart": ["session_id"],
    "update_cart_item": ["session_id", "cart_id", "expected_cart_version", "cart_line_id", "quantity"],
    "remove_cart_item": ["session_id", "cart_id", "expected_cart_version", "cart_line_id"],
    "apply_offer": ["session_id", "offer_id", "expected_session_context_version", "expected_cart_version"],
    "prepare_checkout": ["session_id", "cart_id", "expected_session_context_version", "expected_cart_version"],
    "get_order": ["session_id", "merchant_order_id"]
  }
}
