FROM node:22-bookworm-slim
WORKDIR /workspace
COPY apps/atlaslab/package.json ./apps/atlaslab/package.json
COPY apps/atlaslab/tsconfig.json ./apps/atlaslab/tsconfig.json
COPY apps/atlaslab/src ./apps/atlaslab/src
COPY db/atlaslab/scenarios ./db/atlaslab/scenarios
COPY db/atlaslab/migrations ./db/atlaslab/migrations
COPY schemas/mcp ./schemas/mcp
COPY testdata/hostkeys ./testdata/hostkeys
WORKDIR /workspace/apps/atlaslab
RUN npm install
ENV ATLASLAB_HTTP_ADDR=0.0.0.0:8090
EXPOSE 8090
CMD ["node", "--import", "tsx", "src/main.ts"]
