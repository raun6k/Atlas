{
  "name": "@atlas/atlaslab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node --import tsx src/main.ts",
    "migrate": "node --import tsx src/db/migrate.ts",
    "test": "node --import tsx --test --test-reporter=spec src/*.test.ts src/*/*.test.ts ../../tests/contract/lab/*.test.ts"
  },
  "dependencies": {
    "jose": "^6.0.11",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
