# Lab-only overlay. Prefer the repo-root .env for Compose.
# OPENROUTER_API_KEY empty keeps deterministic runs available.

ATLASLAB_POSTGRES_URL=postgres://atlaslab:atlaslab@localhost:5433/atlaslab?sslmode=disable
ATLAS_MCP_URL=http://127.0.0.1:8080/mcp
ATLASLAB_HOST_BEARER=
ATLASLAB_HOST_SIGNING_KEY=
ATLASLAB_FIXTURE_CONTROL_CREDENTIAL=
ATLASLAB_FIXTURE_SNAPSHOT_ID=fix_quickmart_v1
OPENROUTER_API_KEY=

ATLASLAB_MAX_TURNS=24
ATLASLAB_MAX_TOOL_CALLS=40
ATLASLAB_MAX_WALL_SECONDS=900
ATLASLAB_MAX_TOKENS=100000
ATLASLAB_MAX_COST_USD=1.50
ATLASLAB_DEFAULT_BUYER_SPEND_MINOR=250000
ATLASLAB_CUSTOM_INPUT_MAX_CHARS=4000
