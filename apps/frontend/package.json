{
  "name": "@atlas/frontend",
  "private": true,
  "version": "0.0.0",
  "description": "Atlas merchant evidence console (Razorpay Test Mode)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:secrets",
    "test:watch": "vitest",
    "test:secrets": "node tests/secret-scan.mjs",
    "test:e2e": "playwright test",
    "mock": "node mocks/server.mjs"
  },
  "dependencies": {
    "next": "^15.5.24",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.23"
    }
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.24",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
